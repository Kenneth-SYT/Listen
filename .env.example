# Public configuration only. Never put secret/service-role keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Temporary testing switch. Change to true when confirmation emails are restored.
VITE_REQUIRE_EMAIL_VERIFICATION=false
# Optional future second factor. Requires Supabase Phone Auth and an SMS provider.
VITE_ENABLE_PHONE_VERIFICATION=false
